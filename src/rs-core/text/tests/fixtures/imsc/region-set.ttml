<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
<head><layout><region xml:id="r" tts:origin="10% 70%" tts:extent="80% 25%"><set begin="2s" end="4s" tts:backgroundColor="black"/></region></layout></head>
<body><div><p begin="1s" end="5s" region="r" tts:textOutline="black 2px 1px" tts:lineHeight="120%">Outlined text</p></div></body>
</tt>

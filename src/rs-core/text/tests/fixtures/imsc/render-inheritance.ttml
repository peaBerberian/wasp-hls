<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en">
<head><styling><style xml:id="base" tts:fontWeight="bold"/></styling><layout><region xml:id="r" tts:origin="10% 70%" tts:extent="80% 25%" tts:color="red" tts:fontSize="20px"/></layout></head>
<body tts:fontSize="200%"><div><p region="r" style="base" begin="1s" end="4s" tts:fontSize="50%">Hello <span tts:color="yellow">world</span>!</p></div></body>
</tt>
